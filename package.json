{
  "name": "dark-matter-ship-builder",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "npm run icons:manifest && vite",
    "icons:manifest": "node scripts/generate-game-icons-manifest.mjs",
    "build": "npm run icons:manifest && tsc -b && vite build",
    "version:bump": "node scripts/bump-version.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit": "npm audit"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
