{
  "name": "dark-matter-ship-builder",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "npm run icons:manifest && vite",
    "icons:manifest": "node scripts/generate-game-icons-manifest.mjs",
    "build": "npm run icons:manifest && tsc -b && vite build",
    "version:bump": "node scripts/bump-version.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "audit": "npm audit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
